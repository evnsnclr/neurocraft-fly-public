# Loopback bridge settings. Generate a fresh token per run; never commit a real value.
NEUROCRAFT_HOST=127.0.0.1
NEUROCRAFT_PORT=8765
# Export NEUROCRAFT_RUN_TOKEN in the launching shell. It must contain 32-256
# URL-safe characters. The token never crosses the wire: both endpoints prove
# possession with HMAC over the handshake transcript (ADR 0007).
