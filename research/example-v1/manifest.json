  "source_selection_policy": {
    "candidate_resolution": {
      "ambiguous_role_policy": "fail",
      "motor": {
        "subclass_exact": "wm",
        "superclass_exact": "vnc_motor"
      },
      "named_types_exact": [
        "AN27X008",
        "DNg07"
      ],
      "sensory_union": [
        {
          "type_prefix": "JO-E"
        },
        {
          "entryNerve_exact_any": [
            "ADMN",
            "DMetaN"
          ],
          "subclass_exact": "campaniform sensilla"
        }
      ],
      "string_matching": "case-sensitive exact except the declared JO-E prefix"
    },
    "complete_selected_path_criterion": {
      "definition": "For each side independently, concatenate one simple directed sensory-to-named segment and one simple directed named-to-motor segment, omitting the repeated named join node. Each segment has 1..3 source edges. Role endpoints must have that exact derived side; intermediate nodes are not side-filtered.",
      "direction": "body_pre -> body_post",
      "duplicate_directed_pair_policy": "fail across every source weight row",
      "maximum_edges_per_segment": 3,
      "objective": "maximize the minimum raw source weight over both segments",
      "path_edge_minimum_weight_inclusive": 10,
      "path_vertex_eligibility": "every path body must have a source annotation row",
      "segment_vertex_repetition": "forbidden within each segment",
      "tie_break": "lexicographically smallest complete ordered source body-ID tuple among all maximum-bottleneck complete paths"
    },
    "fixture_closure": {
      "definition": "all source edges whose endpoints are both selected path nodes",
      "minimum_weight_inclusive": 5,
      "self_edges": "included when present"
    },
    "side_derivation": {
      "allowed_evidence": [
        "rootSide exact L/R",
        "somaSide exact L/R",
        "instance _L/_R suffix"
      ],
      "conflict": "fail",
      "missing_required_role_side": "fail",
      "unresolved_intermediate_side": "retain as null"
    },
    "transmitter_and_sign": {
      "mapping": "none",
      "policy": "copy the exact aggregate transmitter row when present; retain unknown edge signs"
    }
  },
